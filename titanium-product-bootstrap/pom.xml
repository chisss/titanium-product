<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.titanium</groupId>
        <artifactId>titanium-product</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>titanium-product-bootstrap</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>titanium-product-bootstrap</name>
    <description>Product Service Bootstrap Module</description>
    <packaging>jar</packaging>

    <dependencies>
        <!-- Web Module -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-product-web</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Infrastructure Module（组合根装配仓储实现/写侧投影/JPA 实体） -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-product-infrastructure</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Query Module（组合根装配读模型投影/读侧仓储/DLQ 定时任务） -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-product-query</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Spring Boot Dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Jackson JSR310 for Axon compatibility -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- 架构守护：共享 ArchUnit 基类（版本由 titanium-parent 管理） -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-build-tools</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Liquibase -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-liquibase</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.titanium.product.ProductApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
