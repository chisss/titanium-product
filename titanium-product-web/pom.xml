<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.titanium</groupId>
        <artifactId>titanium-product</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>titanium-product-web</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>titanium-product-web</name>
    <description>Product Service Web Module</description>

    <dependencies>
        <!-- API Module -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-product-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Application Module（Controller 编排入口：command/query 应用服务） -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-product-application</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Query Module（读入口返回 XxxQueryResult DTO） -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-product-query</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Domain Module（WebMapper Request→Command/值对象 转换） -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-product-domain</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Common Module（本域专属枚举） -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-product-common</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Spring Boot Dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
