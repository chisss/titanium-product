<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- CQRS 读模型表：由产品模板域事件投影维护，与写侧 t_product_template 物理隔离 -->
    <changeSet id="20260702-product-template-view-projection" author="titanium-cqrs">
        <createTable tableName="t_product_template_view" remarks="产品模板读模型表（CQRS Projection）">
            <column name="template_id" type="VARCHAR(36)" remarks="模板ID（读模型主键）">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_t_product_template_view"/>
            </column>
            <column name="template_code" type="VARCHAR(64)" remarks="模板编码"/>
            <column name="template_name" type="VARCHAR(128)" remarks="模板名称"/>
            <column name="insurance_category" type="VARCHAR(32)" remarks="险种大类"/>
            <column name="insurance_type" type="VARCHAR(32)" remarks="险种类型"/>
            <column name="product_id" type="VARCHAR(36)" remarks="关联产品ID"/>
            <column name="issuance_mode" type="VARCHAR(512)" remarks="出单模式"/>
            <column name="policy_stages_json" type="TEXT" remarks="出单阶段定义（JSON）"/>
            <column name="underwriting_config_json" type="TEXT" remarks="核保配置（JSON）"/>
            <column name="policy_structure_json" type="TEXT" remarks="保单结构配置（JSON）"/>
            <column name="maintenance_config_json" type="TEXT" remarks="保全配置（JSON）"/>
            <column name="claim_config_json" type="TEXT" remarks="理赔配置（JSON）"/>
            <column name="billing_config_json" type="TEXT" remarks="计费配置（JSON）"/>
            <column name="reinsurance_config_json" type="TEXT" remarks="再保险配置（JSON）"/>
            <column name="status" type="VARCHAR(32)" remarks="模板状态"/>
            <column name="tenant_id" type="VARCHAR(36)" remarks="租户ID（多租户隔离）">
                <constraints nullable="false"/>
            </column>
            <column name="create_time" type="DATETIME" remarks="读模型创建时间">
                <constraints nullable="false"/>
            </column>
            <column name="update_time" type="DATETIME" remarks="读模型更新时间">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0" remarks="乐观锁版本">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="t_product_template_view" constraintName="uk_template_view_code_tenant"
                             columnNames="template_code, tenant_id"/>
        <createIndex tableName="t_product_template_view" indexName="idx_template_view_product">
            <column name="product_id"/>
            <column name="tenant_id"/>
        </createIndex>
        <createIndex tableName="t_product_template_view" indexName="idx_template_view_insurance_type">
            <column name="insurance_type"/>
            <column name="tenant_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
