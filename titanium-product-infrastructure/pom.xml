<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.titanium</groupId>
        <artifactId>titanium-product</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>titanium-product-infrastructure</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>titanium-product-infrastructure</name>
    <description>Product Service Infrastructure Module</description>

    <dependencies>
        <!-- Domain Module -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-product-domain</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- 通用内核(实体基类BaseEntity) -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-common</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- 产品域常量(Kafka Topic 常量 ProductConstants)，并传递 fastjson2 -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-product-common</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Product 定价编排的跨域 API 契约，仅由 Infrastructure Adapter 使用 -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-feature-center-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-rule-engine-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-channel-api</artifactId>
        </dependency>
        <!-- 条款域 Feign 契约：仅 ClauseExistenceAdapter 使用（产品绑定条款时的存在性校验）。
             🔴 该依赖曾在 m10-1304 因「全仓零引用」被删除；本次是**首次真实引用**，
             引用点为 infrastructure/adapter/clause/ClauseExistenceAdapter.java。 -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-clause-api</artifactId>
        </dependency>
        <!-- 理赔域 Feign 契约：仅 ClaimHistoryAdapter 使用（G11/g11-03 NCD 反算按车辆取历史赔案）。
             新增跨域 Feign 契约须同批完成三处登记，见 titanium-product/CLAUDE.md §7.13。 -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-claim-api</artifactId>
        </dependency>

        <!-- Spring Boot Dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Kafka 跨域事件外发(对齐 customer 域桥接模式) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- Axon Framework -->
        <dependency>
            <groupId>org.axonframework</groupId>
            <artifactId>axon-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <!-- 测试依赖(版本由 parent 管理) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
