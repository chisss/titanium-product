<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.titanium</groupId>
        <artifactId>titanium-product</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>titanium-product-infrastructure</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>titanium-product-infrastructure</name>
    <description>Product Service Infrastructure Module</description>

    <dependencies>
        <!-- Domain Module -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-product-domain</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- 通用内核(实体基类BaseEntity) -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-common</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- 产品域常量(Kafka Topic 常量 ProductConstants) -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-product-common</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- 🔴 m27-04/PKG-04：跨域赔案事件投影写入读模型，需要读侧 View/ViewRepository
             （同 billing-infrastructure → billing-query 的既有依赖方向：infra 依赖 query 的读模型） -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-product-query</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- 跨域入站报文解析（fastjson2 一次性反序列化为防腐 record；
             此前经 product-common 传递获得，m27-04 起显式声明以免上游传递面变动导致编译失败） -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
        </dependency>

        <!-- Product 定价编排的跨域 API 契约，仅由 Infrastructure Adapter 使用 -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-feature-center-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-rule-engine-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-channel-api</artifactId>
        </dependency>
        <!-- 条款域 Feign 契约：仅 ClauseExistenceAdapter 使用（产品绑定条款时的存在性校验）。
             🔴 该依赖曾在 m10-1304 因「全仓零引用」被删除；本次是**首次真实引用**，
             引用点为 infrastructure/adapter/clause/ClauseExistenceAdapter.java。 -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-clause-api</artifactId>
        </dependency>
        <!-- 🔴 m27-04/PKG-04：理赔域 Feign 契约已移除——NCD 历史赔案改由本域消费
             claim-created/updated/status-changed/rejected 事件投影到 t_product_claim_history_view，
             不再同步调用 ClaimApi（product→claim 是服务依赖图的反馈边）。 -->

        <!-- Spring Boot Dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Kafka 跨域事件外发(对齐 customer 域桥接模式) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- Axon Framework -->
        <dependency>
            <groupId>org.axonframework</groupId>
            <artifactId>axon-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <!-- 测试依赖(版本由 parent 管理) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    
        <!-- m27-01/PKG-01：显式声明实际使用的内核/starter 模块（原经 titanium-common 传递获得） -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-kernel</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <!-- m27-01/PKG-01：显式声明实际使用的内核/starter 模块（原经 titanium-common 传递获得） -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-starter-feign</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <!-- m27-01/PKG-01：显式声明实际使用的内核/starter 模块（原经 titanium-common 传递获得） -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-starter-kafka</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <!-- m27-02/PKG-02：api 契约层只以 provided 暴露 Feign 注解、不再向下游传递运行时；
             @EnableFeignClients 所需的 Spring Cloud OpenFeign 由本模块显式声明 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
    </dependencies>
</project>
